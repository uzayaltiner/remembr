{
  "name": "remembr",
  "version": "0.1.0-pre",
  "description": "Recall anything across your tools — semantic search MCP server + CLI for Claude Code, Cursor, and any MCP client.",
  "type": "module",
  "bin": {
    "remembr": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "remembr": "bun run src/cli.tsx",
    "build": "bun build src/cli.tsx --target=bun --outdir=dist",
    "build:binary": "bun build src/cli.tsx --compile --outfile=dist/remembr",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "cursor",
    "ai-memory",
    "semantic-search",
    "vector-search",
    "local-first",
    "privacy",
    "cli",
    "terminal"
  ],
  "author": "Uzay Altıner",
  "license": "MIT",
  "homepage": "https://github.com/uzayaltiner/remembr",
  "repository": {
    "type": "git",
    "url": "https://github.com/uzayaltiner/remembr.git"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.7.0",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.0",
    "@types/node": "^25.6.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.12",
    "typescript": "^5.7.2"
  }
}
